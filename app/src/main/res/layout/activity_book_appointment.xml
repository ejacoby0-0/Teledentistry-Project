<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Page Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book Appointment"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose a practitioner and an available appointment time."
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />


        <!-- Practitioner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Practitioner"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSelectPractitioner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Practitioner"
            android:layout_marginBottom="24dp" />


        <!-- Available Appointments -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Available Appointments"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSelectPractitionerMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select a practitioner to view available appointments."
            android:layout_marginBottom="8dp" />


        <!-- Dynamically generated appointment buttons -->
        <LinearLayout
            android:id="@+id/layoutAvailableSlots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />


        <!-- Selected Appointment -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selected Appointment"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSelectedAppointment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No appointment selected"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />


        <!-- Book -->
        <Button
            android:id="@+id/btnBookAppointment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Book Appointment"
            android:enabled="false"
            android:layout_marginBottom="32dp" />

    </LinearLayout>

</ScrollView>