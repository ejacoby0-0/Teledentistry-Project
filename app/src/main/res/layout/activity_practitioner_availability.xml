<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage Availability"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add the dates and times when you are available for patient appointments."
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <!-- Date -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSelectDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Date"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- Start Time -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Time"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSelectStartTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Start Time"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- End Time -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="End Time"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSelectEndTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select End Time"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <!-- Save -->

        <Button
            android:id="@+id/btnSaveAvailability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Availability" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Availability"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp" />

        <!-- Existing availability will appear here -->

        <LinearLayout
            android:id="@+id/layoutAvailabilityList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvNoAvailability"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No availability added yet."
            android:textSize="16sp"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>