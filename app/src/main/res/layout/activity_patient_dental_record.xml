<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Dental Record"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#006874"
            android:layout_marginBottom="8dp" />

        <!-- Patient information -->
        <TextView
            android:id="@+id/tvPatientDentalInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Patient information"
            android:textSize="16sp"
            android:textColor="#555555"
            android:layout_marginBottom="20dp" />

        <!-- Record status -->
        <TextView
            android:id="@+id/tvPatientDentalRecordStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading dental record..."
            android:textSize="15sp"
            android:layout_marginBottom="20dp" />

        <!-- Teeth heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Teeth"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#006874"
            android:layout_marginBottom="12dp" />

        <!-- Read-only tooth records -->
        <LinearLayout
            android:id="@+id/layoutPatientTeeth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</ScrollView>