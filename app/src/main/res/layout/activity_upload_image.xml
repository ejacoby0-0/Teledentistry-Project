<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dental_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload Dental Image"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/dental_primary"
            android:layout_marginBottom="20dp" />

        <!-- Image Type Spinner -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Image Category:"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spImageType"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_message_input"
            android:layout_marginBottom="16dp" />

        <!-- Preview Container -->
        <ImageView
            android:id="@+id/ivImagePreview"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerInside"
            android:background="#E0E0E0"
            android:contentDescription="Dental Image Preview"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectImage"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Choose Image File"
            android:textAllCaps="false"
            android:textColor="@color/dental_primary"
            app:cornerRadius="10dp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpload"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Upload Image"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/dental_primary"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>