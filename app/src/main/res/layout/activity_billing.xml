<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Billing &amp; Invoices"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#006874"
            android:layout_marginBottom="8dp"/>

        <!-- Appointment -->
        <TextView
            android:id="@+id/tvBillingAppointment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Appointment"
            android:textSize="16sp"
            android:textColor="#6C757D"
            android:layout_marginBottom="12dp"/>

        <!-- Loading / Empty State -->
        <TextView
            android:id="@+id/tvBillingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading billing..."
            android:textSize="14sp"
            android:textColor="#6C757D"
            android:layout_marginBottom="12dp"/>

        <!--
            Billing cards will be dynamically
            loaded from PocketBase here.
        -->
        <LinearLayout
            android:id="@+id/layoutBillingRecords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <!-- Practitioner management button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateBilling"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:text="Create Billing Record"
            android:textAllCaps="false"/>

        <!-- Keep collaborator's payment concept for later -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPayNow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="24dp"
            android:text="Pay Outstanding Balance"
            android:textAllCaps="false"
            android:visibility="gone"/>

    </LinearLayout>

</ScrollView>