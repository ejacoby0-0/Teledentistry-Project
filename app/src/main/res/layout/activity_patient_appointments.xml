<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/dental_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Smile Sessions"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/dental_primary"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvNoAppointments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading smile sessions..."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/layoutAppointments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </LinearLayout>
</ScrollView>