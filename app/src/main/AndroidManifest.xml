<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".TeledentistryApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.TeledentistryProject">

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />

        <!-- Forgot Password -->
        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false" />

        <!-- Patient Portal Activities -->
        <activity
            android:name=".ui.patient.PatientHomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.patient.PatientProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.patient.BookAppointmentActivity"
            android:exported="false" />
        <activity
            android:name=".ui.patient.ChatActivity"
            android:exported="false" />
        <activity
            android:name=".ui.patient.UploadImageActivity"
            android:exported="false" />
        <activity
            android:name=".ui.patient.TreatmentPlanActivity"
            android:exported="false" />
        <activity
            android:name=".ui.patient.BillingActivity"
            android:exported="false" />
        <activity
            android:name=".ui.patient.VideoCallActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".ui.patient.PatientAppointmentsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.patient.PatientTreatmentPlanActivity"
            android:exported="false" />
        <activity
            android:name=".ui.patient.PatientPrescriptionsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.patient.PatientBillingActivity"
            android:exported="false" />
        <activity
            android:name=".ui.patient.PatientDentalRecordActivity"
            android:exported="false" />
        <activity
            android:name=".ui.patient.PatientInsuranceClaimsActivity"
            android:exported="false" />

        <!-- Practitioner Portal Activities -->
        <activity
            android:name=".ui.dentist.DentistHomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.dentist.DentistProfileActivity"
            android:exported="false" />
        <activity
            android:name=".ui.dentist.PatientRecordsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.dentist.PractitionerAvailabilityActivity"
            android:exported="false" />
        <activity
            android:name=".ui.dentist.UploadedImagesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.dentist.TreatmentManagementActivity"
            android:exported="false" />
        <activity
            android:name=".ui.dentist.PractitionerAppointmentsActivity"
            android:exported="false" />

        <!-- Admin Portal Activities -->
        <activity
            android:name=".ui.admin.AdminHomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.PractitionerApprovalsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.ManageUsersActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.UserEnquiriesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.admin.ReportsActivity"
            android:exported="false" />

        <!-- Consultation Activities -->
        <activity
            android:name=".ui.consultation.ConsultationActivity"
            android:exported="false" />

    </application>

</manifest>
