<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dental_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header with Logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="165dp"
                    android:layout_height="52dp"
                    android:src="@drawable/logo"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitStart"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvPractitionerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Practitioner"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/dental_primary"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDentistLogout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:textAllCaps="false"
                style="?attr/materialButtonOutlinedStyle"
                app:cornerRadius="10dp"/>
        </LinearLayout>

        <!-- Navigation Buttons -->
        <Button
            android:id="@+id/btnStartConsultation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Start Video Consultation"/>

        <Button
            android:id="@+id/btnViewAppointments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="View Appointments"/>

        <Button
            android:id="@+id/btnPatientRecords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Patient Records"/>

        <Button
            android:id="@+id/btnUploadedImages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Uploaded Images"/>

        <Button
            android:id="@+id/btnTreatmentManagement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Treatment Management"/>

        <Button
            android:id="@+id/btnDentistProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Profile"/>

        <Button
            android:id="@+id/btnManageAvailability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Manage Availability"/>

    </LinearLayout>
</ScrollView>
