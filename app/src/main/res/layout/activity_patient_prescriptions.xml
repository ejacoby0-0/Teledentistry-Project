<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Page Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Prescriptions"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#006874"
            android:layout_marginBottom="8dp"/>

        <!-- Patient Name -->
        <TextView
            android:id="@+id/tvPatientPrescriptionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Patient"
            android:textSize="16sp"
            android:textColor="#6C757D"
            android:layout_marginBottom="16dp"/>

        <!-- Loading / Empty State -->
        <TextView
            android:id="@+id/tvPatientPrescriptionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading prescriptions..."
            android:textSize="14sp"
            android:textColor="#6C757D"
            android:layout_marginBottom="16dp"/>

        <!-- Read-only prescription cards -->
        <LinearLayout
            android:id="@+id/layoutPatientPrescriptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </LinearLayout>

</ScrollView>