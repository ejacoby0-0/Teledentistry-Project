<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TeledentistryProject" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/dental_primary</item>
        <item name="colorSecondary">@color/dental_secondary</item>
        <item name="android:windowBackground">@color/dental_background</item>
        <item name="colorSurface">@color/dental_surface</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/dental_primary</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/ic_smile_white</item>
    </style>

    <style name="Widget.Dental.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/dental_secondary</item>
        <item name="hintTextColor">@color/dental_secondary</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Theme.TeledentistryProject" parent="Base.Theme.TeledentistryProject" />
</resources>
