<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book Appointment"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose a practitioner and an available appointment time."
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <!-- Practitioner -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Practitioner"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSelectPractitioner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Practitioner" />

        <!-- Available Slots -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Available Appointments"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvSelectPractitionerMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select a practitioner to view available appointments."
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/layoutAvailableSlots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <!-- Selected Appointment -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selected Appointment"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSelectedAppointment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No appointment selected."
            android:textSize="16sp"
            android:padding="12dp" />

        <!-- Book -->

        <Button
            android:id="@+id/btnBookAppointment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Book Appointment"
            android:enabled="false"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>