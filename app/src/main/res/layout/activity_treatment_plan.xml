<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Treatment Plan &amp; Progress"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#006874"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvTreatmentPatient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patient"
            android:textSize="16sp"
            android:textColor="#6C757D"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvTreatmentPlanStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading treatment plans..."
            android:textColor="#6C757D"
            android:layout_marginBottom="12dp"/>

        <!--
            Treatment plan cards will be dynamically
            added here from PocketBase.
        -->
        <LinearLayout
            android:id="@+id/layoutTreatmentPlans"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddTreatmentPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Treatment Plan"
            android:textAllCaps="false"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>

</ScrollView>