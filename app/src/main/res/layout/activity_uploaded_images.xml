<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/dental_background">

    <TextView
        android:id="@+id/tvPatientHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Patient Uploaded Dental Images"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/dental_primary"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvImageStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Loading uploaded images..."
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="12dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/layoutUploadedImages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>