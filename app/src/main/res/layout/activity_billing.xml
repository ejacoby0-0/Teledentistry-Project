<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView
        android:id="@+id/tvBillingAppointment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Billing Appointment"/>
    <TextView
        android:id="@+id/tvBillingStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Billing Status"/>
    <LinearLayout
        android:id="@+id/layoutBillingRecords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>
    <Button
        android:id="@+id/btnCreateBilling"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create Billing"/>
    <Button
        android:id="@+id/btnPayNow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pay Now"/>
</LinearLayout>
