<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:padding="20dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Insurance Claims"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#006874"
            android:layout_marginBottom="8dp" />

        <!-- Billing information -->
        <TextView
            android:id="@+id/tvClaimBilling"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Billing Record"
            android:textSize="16sp"
            android:textColor="#6C757D"
            android:layout_marginBottom="12dp" />

        <!-- Loading / Empty State -->
        <TextView
            android:id="@+id/tvClaimStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading insurance claims..."
            android:textSize="14sp"
            android:textColor="#6C757D"
            android:layout_marginBottom="12dp" />

        <!-- Dynamic insurance claim cards -->
        <LinearLayout
            android:id="@+id/layoutInsuranceClaims"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Create Claim -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateInsuranceClaim"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="Create Insurance Claim"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>