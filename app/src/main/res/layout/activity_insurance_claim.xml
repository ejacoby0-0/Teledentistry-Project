<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView
        android:id="@+id/tvClaimBilling"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Claim Billing"/>
    <TextView
        android:id="@+id/tvClaimStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Claim Status"/>
    <LinearLayout
        android:id="@+id/layoutInsuranceClaims"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>
    <Button
        android:id="@+id/btnCreateInsuranceClaim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create Claim"/>
</LinearLayout>
