<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.teledentistry_project"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="36" />

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <permission
        android:name="com.example.teledentistry_project.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.example.teledentistry_project.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="com.example.teledentistry_project.TeledentistryApp"
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.TeledentistryProject"
        android:usesCleartextTraffic="true" >
        <activity
            android:name="com.example.teledentistry_project.ui.auth.LoginActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.example.teledentistry_project.MainActivity"
            android:exported="false" />
        <activity
            android:name="com.example.teledentistry_project.ui.auth.RegisterActivity"
            android:exported="false" />

        <!-- Forgot Password -->
        <activity
            android:name="com.example.teledentistry_project.ui.auth.ForgotPasswordActivity"
            android:exported="false" />

        <!-- Patient Portal Activities -->
        <activity
            android:name="com.example.teledentistry_project.ui.patient.PatientHomeActivity"
            android:exported="false" />
        <activity
            android:name="com.example.teledentistry_project.ui.patient.PatientProfileActivity"
            android:exported="false" />
        <activity
            android:name="com.example.teledentistry_project.ui.patient.BookAppointmentActivity"
            android:exported="false" />
        <activity
            android:name="com.example.teledentistry_project.ui.patient.ChatActivity"
            android:exported="false" />
        <activity
            android:name="com.example.teledentistry_project.ui.patient.UploadImageActivity"
            android:exported="false" />
        <activity
            android:name="com.example.teledentistry_project.ui.patient.TreatmentPlanActivity"
            android:exported="false" />
        <activity
            android:name="com.example.teledentistry_project.ui.patient.BillingActivity"
            android:exported="false" />
        <activity
            android:name="com.example.teledentistry_project.ui.patient.VideoCallActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name="com.example.teledentistry_project.ui.patient.PatientAppointmentsActivity"
            android:exported="false" />
        <activity
            android:name="com.example.teledentistry_project.ui.patient.PatientTreatmentPlanActivity"
            android:exported="false" />
        <activity
            android:name="com.example.teledentistry_project.ui.patient.PatientPrescriptionsActivity"
            android:exported="false" />
        <activity
            android:name="com.example.teledentistry_project.ui.patient.PatientBillingActivity"
            android:exported="false" />
        <activity
            android:name="com.example.teledentistry_project.ui.patient.PatientDentalRecordActivity"
            android:exported="false" />
        <activity
            android:name="com.example.teledentistry_project.ui.patient.PatientInsuranceClaimsActivity"
            android:exported="false" />

        <!-- Practitioner Portal Activities -->
        <activity
            android:name="com.example.teledentistry_project.ui.dentist.DentistHomeActivity"
            android:exported="false" />
        <activity
            android:name="com.example.teledentistry_project.ui.dentist.DentistProfileActivity"
            android:exported="false" />
        <activity
            android:name="com.example.teledentistry_project.ui.dentist.PatientRecordsActivity"
            android:exported="false" />
        <activity
            android:name="com.example.teledentistry_project.ui.dentist.PractitionerAvailabilityActivity"
            android:exported="false" />
        <activity
            android:name="com.example.teledentistry_project.ui.dentist.UploadedImagesActivity"
            android:exported="false" />
        <activity
            android:name="com.example.teledentistry_project.ui.dentist.TreatmentManagementActivity"
            android:exported="false" />
        <activity
            android:name="com.example.teledentistry_project.ui.dentist.PractitionerAppointmentsActivity"
            android:exported="false" />

        <!-- Admin Portal Activities -->
        <activity
            android:name="com.example.teledentistry_project.ui.admin.AdminHomeActivity"
            android:exported="false" />
        <activity
            android:name="com.example.teledentistry_project.ui.admin.PractitionerApprovalsActivity"
            android:exported="false" />
        <activity
            android:name="com.example.teledentistry_project.ui.admin.ManageUsersActivity"
            android:exported="false" />
        <activity
            android:name="com.example.teledentistry_project.ui.admin.UserEnquiriesActivity"
            android:exported="false" />
        <activity
            android:name="com.example.teledentistry_project.ui.admin.ReportsActivity"
            android:exported="false" />

        <!-- Consultation Activities -->
        <activity
            android:name="com.example.teledentistry_project.ui.consultation.ConsultationActivity"
            android:exported="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.example.teledentistry_project.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>