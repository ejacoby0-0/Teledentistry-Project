<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dental_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavContainer"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome back,"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"/>

                    <TextView
                        android:id="@+id/tvPatientName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Patient"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/dental_primary"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    style="?attr/materialButtonOutlinedStyle"
                    app:cornerRadius="10dp"/>
            </LinearLayout>

            <!-- Upcoming Appointment Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/dental_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upcoming Oral Consultation"
                        android:textStyle="bold"
                        android:textColor="@color/dental_primary"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvAppointmentInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dr. Emily Johnson - Oct 02, 10:30 AM"
                        android:textSize="16sp"
                        android:textStyle="normal"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnJoinCall"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="JOIN VIDEO CONSULTATION"
                        app:cornerRadius="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Quick Actions Grid -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Patient Quick Actions"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <Button
                    android:id="@+id/btnBookAppointment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Book Appointment"/>
                <Button
                    android:id="@+id/btnAppointments"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="My Appointments" />

                <Button
                    android:id="@+id/btnDentalRecord"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="My Dental Record"/>

                <Button
                    android:id="@+id/btnChatDentist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Chat Dentist"/>

                <Button
                    android:id="@+id/btnUploadImage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Upload Image"/>

                <Button
                    android:id="@+id/btnTreatmentPlan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Treatment Plan"/>

                <Button
                    android:id="@+id/btnPrescriptions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="My Prescriptions"/>

                <Button
                    android:id="@+id/btnBilling"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Billing &amp; Rx"/>

                <Button
                    android:id="@+id/btnInsuranceClaims"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="My Insurance Claims"/>
            </GridLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Polished Material Bottom Navigation Bar Container with Icons -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        app:cardElevation="12dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="@color/dental_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:weightSum="4"
            android:paddingHorizontal="4dp">

            <com.google.android.material.button.MaterialButton
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="Home"
                android:textSize="11sp"
                android:textColor="@color/dental_primary"
                style="?attr/materialButtonOutlinedStyle"
                app:icon="@drawable/ic_home"
                app:iconTint="@color/dental_primary"
                app:iconGravity="textTop"
                app:strokeWidth="0dp"
                app:cornerRadius="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="Consults"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                style="?attr/materialButtonOutlinedStyle"
                app:icon="@drawable/ic_video"
                app:iconTint="@color/text_secondary"
                app:iconGravity="textTop"
                app:strokeWidth="0dp"
                app:cornerRadius="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="Treatment"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                style="?attr/materialButtonOutlinedStyle"
                app:icon="@drawable/ic_treatment"
                app:iconTint="@color/text_secondary"
                app:iconGravity="textTop"
                app:strokeWidth="0dp"
                app:cornerRadius="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="Profile"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                style="?attr/materialButtonOutlinedStyle"
                app:icon="@drawable/ic_profile"
                app:iconTint="@color/text_secondary"
                app:iconGravity="textTop"
                app:strokeWidth="0dp"
                app:cornerRadius="8dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>
