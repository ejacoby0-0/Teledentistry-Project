<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:padding="20dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Page Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prescriptions"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#006874"
            android:layout_marginBottom="8dp" />

        <!-- Patient -->
        <TextView
            android:id="@+id/tvPrescriptionPatient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patient"
            android:textSize="16sp"
            android:textColor="#6C757D"
            android:layout_marginBottom="16dp" />

        <!-- Loading / Empty State -->
        <TextView
            android:id="@+id/tvPrescriptionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading prescriptions..."
            android:textSize="14sp"
            android:textColor="#6C757D"
            android:layout_marginBottom="12dp" />

        <!--
            Prescription cards from PocketBase
            will be dynamically inserted here.
        -->
        <LinearLayout
            android:id="@+id/layoutPrescriptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Create Prescription -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddPrescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Prescription"
            android:textAllCaps="false"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            app:cornerRadius="12dp" />

    </LinearLayout>

</ScrollView>