<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dental_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavContainer"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Practitioner Portal"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"/>

                    <TextView
                        android:id="@+id/tvPractitionerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Practitioner"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/dental_primary"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPractitionerLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logout"
                    android:textAllCaps="false"
                    style="?attr/materialButtonOutlinedStyle"
                    app:cornerRadius="10dp"/>
            </LinearLayout>

            <!-- Today's Schedule Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/dental_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today's Consultation Queue"
                        android:textStyle="bold"
                        android:textColor="@color/success_green"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvNextPatient"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Next: Sarah Williams (10:30 AM)"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartConsultation"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="START VIDEO CONSULTATION"
                        app:cornerRadius="12dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Quick Actions Grid -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clinical &amp; Management"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <Button
                    android:id="@+id/btnViewAppointments"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Appointments"/>

                <Button
                    android:id="@+id/btnPatientRecords"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Patient Records"/>

                <Button
                    android:id="@+id/btnUploadedImages"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Uploaded Images"/>

                <Button
                    android:id="@+id/btnTreatmentManagement"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:text="Treatment &amp; Rx"/>
            </GridLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Polished Material Bottom Navigation Bar Container with Icons -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        app:cardElevation="12dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="@color/dental_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:weightSum="4"
            android:paddingHorizontal="4dp">

            <com.google.android.material.button.MaterialButton
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="Dashboard"
                android:textSize="11sp"
                android:textColor="@color/dental_primary"
                style="?attr/materialButtonOutlinedStyle"
                app:icon="@drawable/ic_home"
                app:iconTint="@color/dental_primary"
                app:iconGravity="textTop"
                app:strokeWidth="0dp"
                app:cornerRadius="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="Schedule"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                style="?attr/materialButtonOutlinedStyle"
                app:icon="@drawable/ic_calendar"
                app:iconTint="@color/text_secondary"
                app:iconGravity="textTop"
                app:strokeWidth="0dp"
                app:cornerRadius="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="Patients"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                style="?attr/materialButtonOutlinedStyle"
                app:icon="@drawable/ic_profile"
                app:iconTint="@color/text_secondary"
                app:iconGravity="textTop"
                app:strokeWidth="0dp"
                app:cornerRadius="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="Profile"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                style="?attr/materialButtonOutlinedStyle"
                app:icon="@drawable/ic_profile"
                app:iconTint="@color/text_secondary"
                app:iconGravity="textTop"
                app:strokeWidth="0dp"
                app:cornerRadius="8dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</RelativeLayout>
