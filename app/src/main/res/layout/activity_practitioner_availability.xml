<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    <Button
        android:id="@+id/btnSelectDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Date"/>
    <Button
        android:id="@+id/btnSelectStartTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Time"/>
    <Button
        android:id="@+id/btnSelectEndTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="End Time"/>
    <Button
        android:id="@+id/btnSaveAvailability"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Availability"/>
    <LinearLayout
        android:id="@+id/layoutAvailabilityList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>
    <TextView
        android:id="@+id/tvNoAvailability"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No Availability"/>
</LinearLayout>
