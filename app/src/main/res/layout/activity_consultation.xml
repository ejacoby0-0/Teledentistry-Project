<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Patient Consultation"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#006874"
            android:layout_marginBottom="8dp" />

        <!-- Appointment information -->
        <TextView
            android:id="@+id/tvAppointmentInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Appointment information"
            android:textSize="16sp"
            android:textColor="#555555"
            android:layout_marginBottom="24dp" />

        <!-- Diagnosis Notes -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Diagnosis / Clinical Notes"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDiagnosisNotes"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:minLines="6"
                android:maxLines="10" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Veiw Dental Record -->
        <Button
            android:id="@+id/btnViewDentalRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Dental Record"
            android:layout_marginBottom="12dp" />

        <!-- Treatment plan -->
        <Button
            android:id="@+id/btnTreatmentPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Treatment Plan"
            android:layout_marginBottom="12dp" />

        <!-- Save Consultation -->
        <Button
            android:id="@+id/btnSaveConsultation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Consultation"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>